# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Full Stack FastAPI Project"
STACK_NAME=full-stack-fastapi-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,https://localhost"

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

SENTRY_DSN=

# Atlys feature analytics
# This file is a checked-in template. Put real credentials in the ignored
# `.env.local`, which is loaded after this file and overrides it.
# If the existing baseline tables were loaded into `default`, change this from
# `atlys` to `default`.
CLICKHOUSE_HOST=your-service.region.provider.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=atlys
CLICKHOUSE_SECURE=true
CLICKHOUSE_CONNECT_TIMEOUT=10
CLICKHOUSE_QUERY_TIMEOUT=30
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# Bounded feature profiling (the feature root defaults to incoming_features/)
FEATURE_MAX_SPEC_BYTES=262144
FEATURE_MAX_EVENT_FILE_BYTES=536870912
FEATURE_MAX_EVENT_LINE_BYTES=1048576
FEATURE_CARDINALITY_SAMPLE_SIZE=1024

# LLM provider (consumed by the agent stages)
FIREWORKS_API_KEY=

FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_TIMEOUT=120

# `docker compose` overrides these values for its HTTP MCP service.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Configure this with your own Docker registry image
DOCKER_IMAGE_BACKEND=backend
