# Prism application service only. Set every secret in Railway Variables; do not
# commit a populated copy of this file.

CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=atlys
CLICKHOUSE_TARGET=cloud

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GOOGLE_API_KEY=

# Use the Langfuse web service's Railway private URL, for example
# http://langfuse-web.railway.internal:3000. The API keys must match its project.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENABLED=true

TABLE_PREFIX=prism_
LOG_LEVEL=INFO
