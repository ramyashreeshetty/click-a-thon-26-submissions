# ClickHouse connection for the ingestion pipeline.
#
#   cp .env.example .env    and fill in your service details.
#
# .env is gitignored. Never commit real credentials.
# Environment variables override anything set here, so CI can inject secrets
# without touching the file.
#
# Verify a target before loading into it:  sonyliv-ingest doctor

# =========================================================================
# ClickHouse Cloud — the production target
# =========================================================================
# Find all of this under your service in https://console.clickhouse.cloud:
#   Connect -> "Native" tab. The hostname there is what goes in HOST, with no
#   protocol and no port. The password is shown once at service creation; reset
#   it from Settings if you no longer have it.
#
# Port 9440 is the native protocol over TLS. Do NOT use 8443 (that is HTTPS) or
# 9000 (native, plaintext — not exposed by Cloud).

CLICKHOUSE_HOST=your-service.region.provider.clickhouse.cloud
CLICKHOUSE_PORT=9440
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=sonyliv

# CLICKHOUSE_DATABASE: use a dedicated database, not `default`.
#
# Schema objects are unprefixed — `events_raw`, `events_clean`, `content_dim` —
# so loading into a shared `default` risks colliding with something else that
# lives there. The DDL is parameterized, so this is a config change rather than
# a rewrite, but the database must already exist: `sonyliv-ingest schema`
# creates tables, not databases.
#
#   CREATE DATABASE sonyliv;
#
# Cloud services idle down when unused. The first connection after that wakes
# the service and can take longer than a warm one; CLICKHOUSE_DIAL_TIMEOUT
# below covers it.

# =========================================================================
# Local ClickHouse in Docker — development
# =========================================================================
#   make ch-up      (starts the container and waits for it to be ready)
#
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_SECURE=false
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=hackathon
# CLICKHOUSE_DATABASE=sonyliv

# =========================================================================
# Client tuning (optional; defaults shown)
# =========================================================================
# CLICKHOUSE_DIAL_TIMEOUT=30s     raise to 60s if a cold Cloud service times out
# CLICKHOUSE_READ_TIMEOUT=5m
# CLICKHOUSE_MAX_OPEN_CONNS=16    keep >= the --workers you pass to a load

# ClickStack connection id, read by hand from the ClickStack UI.
# Managed ClickStack does not expose its connections routes over the Cloud API.
CLICKSTACK_CONNECTION_ID=
