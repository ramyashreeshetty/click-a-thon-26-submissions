                            "table": ""
                          }
                        },
                        "pluginVersion": "4.20.0",
                        "queryType": "table",
                        "rawSql": "WITH per_minute AS (\n    SELECT\n        toStartOfMinute(minute_bucket) AS minute,\n        sum(delta) AS delta\n    FROM concurrency_deltas\n    WHERE minute_bucket BETWEEN $__fromTime AND $__toTime\n    GROUP BY minute\n)\nSELECT\n    minute AS time,\n    sum(delta) OVER (ORDER BY minute) AS active_users\nFROM per_minute\nORDER BY minute\nWITH FILL\nSTEP INTERVAL 1 MINUTE;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
