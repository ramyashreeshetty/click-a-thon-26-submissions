                        "pluginVersion": "4.20.0",
                        "queryType": "table",
                        "rawSql": "WITH run_sum AS (\n    SELECT\n        platform,\n        country,\n        minute_bucket,\n        SUM(delta) OVER (\n            PARTITION BY platform, country\n            ORDER BY minute_bucket\n            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n        ) AS active_users\n    FROM concurrency_deltas\n)\n\nSELECT\n    platform,\n    country,\n    MAX(active_users) AS peak_concurrency\nFROM run_sum\nWHERE $__timeFilter(minute_bucket)\nGROUP BY\n    platform,\n    country\nORDER BY peak_concurrency DESC;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
