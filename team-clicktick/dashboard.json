                        "pluginVersion": "4.20.0",
                        "queryType": "table",
                        "rawSql": "WITH active_counts AS (\n    SELECT\n        minute_bucket,\n        SUM(delta) OVER (\n            ORDER BY minute_bucket\n            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n        ) AS active_users\n    FROM concurrency_deltas\n)\nSELECT\n    minute_bucket AS time,\n    active_users\nFROM active_counts\nWHERE $__timeFilter(minute_bucket)\nORDER BY time;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
