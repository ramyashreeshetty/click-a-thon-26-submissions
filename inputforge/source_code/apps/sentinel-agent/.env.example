# ClickHouse (investigator subagent's read-only data source)
CLICKHOUSE_URL=https://your-clickhouse-host:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Anomaly webhook channel (agent/channels/anomaly.ts)
# Shared secret the caller must send as `Authorization: Bearer <value>`.
ANOMALY_WEBHOOK_SECRET=
# Slack channel ID the anomaly hand-off posts into.
SLACK_ALERTS_CHANNEL_ID=

# Instrumentation (agent/instrumentation.ts) — set either/both to enable export.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to https://cloud.langfuse.com; override for self-hosted or another region.
LANGFUSE_BASE_URL=

HYPERDX_API_KEY=
# Defaults to https://in-otel.hyperdx.io; override for a self-hosted collector.
HYPERDX_OTLP_ENDPOINT=
