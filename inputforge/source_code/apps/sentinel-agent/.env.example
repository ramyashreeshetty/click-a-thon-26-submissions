# ClickHouse (investigator subagent's read-only data source)
CLICKHOUSE_URL=https://your-clickhouse-host:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Anomaly webhook channel (agent/channels/anomaly.ts)
# Shared secret the caller must send as `Authorization: Bearer <value>`.
ANOMALY_WEBHOOK_SECRET=
# Slack channel ID the anomaly hand-off posts into.
SLACK_ALERTS_CHANNEL_ID=

# Instrumentation (agent/instrumentation.ts) — set either/both to enable export.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to https://cloud.langfuse.com; for the root docker-compose.yml stack,
# use http://localhost:3001 with the pre-seeded local project keys below.
LANGFUSE_BASE_URL=

# Local Docker Compose development stack (do not use these credentials outside
# local development):
# LANGFUSE_PUBLIC_KEY=lf_pk_sentinel_local
# LANGFUSE_SECRET_KEY=lf_sk_sentinel_local
# LANGFUSE_BASE_URL=http://localhost:3001

HYPERDX_API_KEY=
# Defaults to https://in-otel.hyperdx.io; override for a self-hosted collector.
HYPERDX_OTLP_ENDPOINT=
# Local ClickStack collector (it does not validate this header):
# HYPERDX_API_KEY=local
# HYPERDX_OTLP_ENDPOINT=http://localhost:4318
