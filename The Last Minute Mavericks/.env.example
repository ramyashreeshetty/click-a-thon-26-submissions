# RootCauseOS — copy to .env and fill in. All values redacted.

# ClickHouse Cloud (primary datastore + analysis engine)
CLICKHOUSE_HOST=your-service.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=REDACTED
CLICKHOUSE_DATABASE=rca            # switch to the unseen DB by editing this one line

# Langfuse (LLM observability — one public trace per scan)
LANGFUSE_PUBLIC_KEY=pk-lf-REDACTED
LANGFUSE_SECRET_KEY=sk-lf-REDACTED
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LLM (narration only — the system runs fully without it)
LLM_API_KEY=sk-REDACTED            # OPENAI_API_KEY also accepted

# ClickStack (OTel -> HyperDX; disabled unless set)
# CLICKSTACK_ENABLED=1
# CLICKSTACK_API_KEY=REDACTED

# UI / integration endpoints
# RCOS_API=http://localhost:8077
# LIBRECHAT_URL=http://localhost:3080
