<mxfile host="app.diagrams.net" modified="2026-08-02T00:00:00.000Z" agent="RootCauseOS" version="24.0.0" type="device">
  <diagram name="RootCauseOS Architecture" id="rcos-arch-1">
    <mxGraphModel dx="1600" dy="820" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;b&gt;RootCauseOS&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px; color: #777777&quot;&gt;automated root-cause analyst for ad revenue — ClickHouse is the store &lt;b&gt;and&lt;/b&gt; the analysis engine; the LLM only narrates&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1F1F1F;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="1520" height="40" as="geometry" />
        </mxCell>

        <!-- ============ BAND A — DATA ============ -->
        <mxCell id="bandA" value="1 · DATA &amp; STORAGE — ClickHouse Cloud" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FFFDF5;strokeColor=#E0CB8E;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#9A7B2F;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="1520" height="124" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Parquet slice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#7A6420&quot;&gt;scripts/load_clickhouse.py&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontColor=#4A3B0E;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="250" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;ad_events&lt;/b&gt; + dim tables&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#7A6420&quot;&gt;geo_device · apps · advertisers&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontColor=#4A3B0E;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="280" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#7A6420&quot;&gt;denormalized · dashboard charts&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontColor=#4A3B0E;" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="250" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;cube&lt;/b&gt;&amp;nbsp;&lt;font style=&quot;font-size: 10px&quot;&gt;— the analysis grid&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#7A6420&quot;&gt;day × 10 dimensions · SUMS only, never ratios&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#FFE599;strokeColor=#BF9000;strokeWidth=2;fontSize=13;fontColor=#3D2F00;" vertex="1" parent="1">
          <mxGeometry x="970" y="100" width="330" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;font style=&quot;font-size: 10px; color:#8A7433&quot;&gt;every ratio computed&lt;br&gt;&lt;b&gt;sum/sum at read time&lt;/b&gt;&lt;br&gt;so any slice rolls up correctly&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#D6B656;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1340" y="100" width="190" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BF9000;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BF9000;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BF9000;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ BAND B — ENGINE ============ -->
        <mxCell id="bandB" value="2 · ENGINE — run_incident.py&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-weight:normal; color:#8AA4C4&quot;&gt;every drill-down is SQL against the cube — no raw row ever leaves ClickHouse&lt;/font&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#F7FAFF;strokeColor=#AEC6E3;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3B6191;" vertex="1" parent="1">
          <mxGeometry x="40" y="208" width="1520" height="166" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;① detect&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#3B6191&quot;&gt;MAD robust z &amp;gt; 3.5 vs the&lt;br&gt;same-weekday median of the&lt;br&gt;3 preceding weeks&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color:#88A6C8&quot;&gt;&lt;i&gt;is this even unusual?&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontColor=#12365E;" vertex="1" parent="1">
          <mxGeometry x="70" y="248" width="232" height="104" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;② gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#3B6191&quot;&gt;≥1,500 req/day, ≥5% move,&lt;br&gt;≥0.5% of the metric&lt;br&gt;+ contaminated days dropped&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color:#88A6C8&quot;&gt;&lt;i&gt;is it big enough to care?&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontColor=#12365E;" vertex="1" parent="1">
          <mxGeometry x="322" y="248" width="232" height="104" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;③ peel&lt;/b&gt;&amp;nbsp;&lt;font style=&quot;font-size:9px&quot;&gt;LOOK OUTSIDE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#3B6191&quot;&gt;re-run each co-suspect with the&lt;br&gt;culprit's rows excluded — shadows&lt;br&gt;vanish, survivors are new incidents&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color:#88A6C8&quot;&gt;&lt;i&gt;who actually did it?&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#BAD3F5;strokeColor=#3B6191;strokeWidth=2;fontSize=13;fontColor=#0D2947;" vertex="1" parent="1">
          <mxGeometry x="574" y="248" width="232" height="104" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;④ descend&lt;/b&gt;&amp;nbsp;&lt;font style=&quot;font-size:9px&quot;&gt;LOOK INSIDE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#3B6191&quot;&gt;greedy cross-cut to 2-D / 3-D —&lt;br&gt;only if the sub-cell concentrates&lt;br&gt;≥1.4× and siblings stay normal&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color:#88A6C8&quot;&gt;&lt;i&gt;can I be more precise?&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontColor=#12365E;" vertex="1" parent="1">
          <mxGeometry x="826" y="248" width="232" height="104" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="&lt;b&gt;⑤ decompose&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#3B6191&quot;&gt;revenue = requests × fill × render&lt;br&gt;× eCPM — split by &lt;b&gt;LMDI&lt;/b&gt;, cross-&lt;br&gt;checked vs exact &lt;b&gt;Shapley&lt;/b&gt; (24 orders)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color:#88A6C8&quot;&gt;&lt;i&gt;which lever moved?&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontColor=#12365E;" vertex="1" parent="1">
          <mxGeometry x="1078" y="248" width="232" height="104" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="&lt;b&gt;Evidence Bundle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#4E7A3F&quot;&gt;verdict · culprit · decomposition&lt;br&gt;ruled-out list&lt;br&gt;&lt;br&gt;every number =&lt;br&gt;&lt;b&gt;{value, sql, query_id}&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontColor=#1E4620;" vertex="1" parent="1">
          <mxGeometry x="1330" y="248" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="eb1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="eAB" value="&lt;font style=&quot;font-size:10px; color:#7A7A7A&quot;&gt;SQL only&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B0B0B0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bandA" target="bandB"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ BAND C1 — TRUST ============ -->
        <mxCell id="bandC1" value="3 · TRUST LAYER — agent/narrate.py + ui/llm.py&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-weight:normal; color:#8FB585&quot;&gt;the differentiator&lt;/font&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#F8FCF7;strokeColor=#B5D6AE;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#4E7A3F;" vertex="1" parent="1">
          <mxGeometry x="40" y="394" width="740" height="176" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;evidence-only prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#4E7A3F&quot;&gt;labels + &lt;b&gt;{{ev_N}}&lt;/b&gt; placeholders.&lt;br&gt;The LLM never sees a raw row&lt;br&gt;and never does arithmetic.&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontColor=#1E4620;" vertex="1" parent="1">
          <mxGeometry x="70" y="432" width="210" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;validator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#4E7A3F&quot;&gt;resolve placeholders, then reject&lt;br&gt;any numeral not in the evidence.&lt;br&gt;Retries once.&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#B9E0B7;strokeColor=#4E7A3F;strokeWidth=2;fontSize=13;fontColor=#14330F;" vertex="1" parent="1">
          <mxGeometry x="305" y="432" width="210" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;deterministic template&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#4E7A3F&quot;&gt;fallback written from the same&lt;br&gt;evidence — every path ends&lt;br&gt;grounded.&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontColor=#1E4620;" vertex="1" parent="1">
          <mxGeometry x="540" y="432" width="210" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;font style=&quot;font-size: 10px; color:#4E7A3F&quot;&gt;LLM chain&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;OPENAI_API_KEY / LLM_API_KEY&lt;/b&gt;&amp;nbsp; →&amp;nbsp; local Ollama&amp;nbsp; →&amp;nbsp; deterministic template&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EDF7EC;strokeColor=#A9CFA3;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="680" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ec1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec2" value="&lt;font style=&quot;font-size:9px; color:#7A7A7A&quot;&gt;on reject&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ BAND C2 — SERVE ============ -->
        <mxCell id="bandC2" value="4 · SERVE — api/server.py (FastAPI)&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-weight:normal; color:#A78FBE&quot;&gt;deployed · http://23.101.175.68:8077&lt;/font&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FCF9FD;strokeColor=#CDB8DC;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#7A5C93;" vertex="1" parent="1">
          <mxGeometry x="820" y="394" width="740" height="176" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;adjudicator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#7A5C93&quot;&gt;sorts into &lt;b&gt;reported / needs_review&lt;br&gt;/ suppressed&lt;/b&gt;. The model may only&lt;br&gt;move trays — never edit a finding.&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontColor=#3C2A47;" vertex="1" parent="1">
          <mxGeometry x="850" y="432" width="250" height="76" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;endpoints&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#7A5C93&quot;&gt;/scan&amp;nbsp;&amp;nbsp;/investigations&lt;br&gt;/health&amp;nbsp;&amp;nbsp;/refresh&amp;nbsp;&amp;nbsp;/docs&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontColor=#3C2A47;" vertex="1" parent="1">
          <mxGeometry x="1125" y="432" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;the parachute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#7A5C93&quot;&gt;any API failure falls back to&lt;br&gt;contracts/fixtures/&lt;br&gt;scan_bundle.json&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#F3ECF7;strokeColor=#B79BC7;dashed=1;fontSize=13;fontColor=#5A4470;" vertex="1" parent="1">
          <mxGeometry x="1350" y="432" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;font style=&quot;font-size: 10px; color:#7A5C93&quot;&gt;one engine, everywhere&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;the CLI, the blind-slice grader and this API all call the &lt;b&gt;same&lt;/b&gt; run_incident.py — we serve what we test&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F8F3FB;strokeColor=#CDB8DC;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="520" width="680" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="eBC" value="&lt;font style=&quot;font-size:10px; color:#7A7A7A&quot;&gt;evidence bundle&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bandB" target="bandC1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eCC" value="&lt;font style=&quot;font-size:10px; color:#7A7A7A&quot;&gt;grounded diagnosis&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bandC1" target="bandC2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ BAND D — CONSUMERS ============ -->
        <mxCell id="bandD" value="5 · CONSUMERS" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#D0D0D0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#707070;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="940" height="170" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;Streamlit dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#666666&quot;&gt;ui/app.py&lt;br&gt;incidents · metrics · evidence ledger&lt;br&gt;(rows, bytes, ms per query)&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="628" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;LibreChat&lt;/b&gt;&amp;nbsp;&lt;font style=&quot;font-size:9px&quot;&gt;self-hosted&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#666666&quot;&gt;integrations/librechat/ :3080&lt;br&gt;via &lt;b&gt;openai_shim.py&lt;/b&gt; :8601&lt;br&gt;model &lt;i&gt;rootcauseos-rca&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="370" y="628" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#666666&quot;&gt;python run_incident.py&lt;br&gt;test-sql/run.sh — blind-slice grader&lt;br&gt;&lt;b&gt;33/33 localised · 1 false positive&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="670" y="628" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eCD" value="&lt;font style=&quot;font-size:10px; color:#7A7A7A&quot;&gt;/scan JSON&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B0B0B0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bandC2" target="bandD"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ BAND E — OBSERVABILITY ============ -->
        <mxCell id="bandE" value="6 · OBSERVABILITY&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-weight:normal; color:#5FA8AD&quot;&gt;instrumented at every stage above&lt;/font&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#F5FCFC;strokeColor=#A8D8DB;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#0E8088;" vertex="1" parent="1">
