# cp .env.example .env — then set OPENAI_API_KEY. Everything else works as-is
# for the local stack. The pre-filled secrets are fine for local dev; regenerate for
# anything shared (openssl rand -hex 32 / -hex 16 for CREDS_IV).

# ── LLM keys (at least one) ───────────────────────────────────────────────────
# Each key is used twice: the matching LibreChat chat endpoint AND the rca-mcp
# narrator (one LLM call per investigation; with no key at all a deterministic
# template narrative is used — the flow still works end to end).
# NARRATOR_MODEL=template skips the LLM entirely (deterministic template narrative,
# zero API calls — verdict/evidence/ruled-out are computed either way; the chat model
# re-narrates stored diagnoses in LibreChat anyway).
# NARRATOR_MODEL picks the narrator's provider: claude-* → Anthropic, gemini-* →
# Google, anything else (gpt-5-nano, …) → OpenAI.
# NARRATOR_EFFORT sets reasoning_effort on OpenAI reasoning models (gpt-5*, o*);
# "minimal" is the default and the right one — the narrator copies figures out of a
# finished bundle, so reasoning tokens are pure cost. Ignored by other providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_KEY=

# ── ClickHouse service accounts (created on first boot by clickhouse-init.sh) ─
# rca_rw: writer (loader, detector seeds, rca-mcp). librechat_ro: read-only
# (mcp-clickhouse). The in-container default user is passwordless, loopback-only.
RCA_RW_PASSWORD=rca_rw_dev
LIBRECHAT_RO_PASSWORD=librechat_ro
RCA_DATASET=main
NARRATOR_MODEL=gpt-5-nano
NARRATOR_EFFORT=minimal

# ── LibreChat basics ──────────────────────────────────────────────────────────
APP_TITLE=RCA Analyst
LIBRECHAT_PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
NO_INDEX=true

# endpoints: built-in Anthropic + OpenAI + Google endpoints + Agents (the RCA agent)
ENDPOINTS=openAI,anthropic,google,agents
ANTHROPIC_MODELS=claude-sonnet-5,claude-opus-5,claude-haiku-4-5-20251001
OPENAI_MODELS=chat-latest,gpt-5-nano,gpt-5-mini,gpt-5,gpt-4o-mini
GOOGLE_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-pro

# auth: open local registration, no email verification
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false

# no meilisearch container in this stack
SEARCH=false

# secrets (pre-generated for local dev — regenerate for anything shared)
CREDS_KEY=2a4d13684544b21c595eb59e70f8e030227f24a83ce71065a344141234e7dada
CREDS_IV=acb680816210737235f761daf5b281fe
JWT_SECRET=5670c780a7d7a9d3ece35210748d2b16f8f406be2ebb5e00dea01c1289c8d779
JWT_REFRESH_SECRET=0c2e1f135ae5ca15a475c7e07b7e6d9e7a19abacc9744d7a661f9c2f7bc33c9e

# ── observability for investigation traces ───────────────────────────────────
# ClickStack (HyperDX) ships IN this stack: UI on :8081, collector in-network.
# Spans flow there by default (compose wires OTEL_EXPORTER_OTLP_ENDPOINT to the
# in-stack collector). Register at http://localhost:8081 once — sources and the
# "RCA Overview" dashboard are auto-seeded within seconds (hyperdx-seed service).
HYPERDX_PORT=8081
# Override only to point somewhere else; set to "" to disable ClickStack export.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
