# Copy to deploy/librechat/.env. This file is safe to commit; never commit the filled copy.

# The local ClickHouse service and its SELECT-only MCP identity.
CH_PASSWORD_LOCAL=replace-with-local-app-password
AGENT_PASSWORD=replace-with-agent-ro-password
CH_DATABASE_LOCAL=default

# Generate each token/secret with: openssl rand -hex 32
CLICKHOUSE_MCP_AUTH_TOKEN=replace-with-64-hex-token
LIBRECHAT_MEILI_MASTER_KEY=replace-with-64-hex-token
LIBRECHAT_JWT_SECRET=replace-with-64-hex-token
LIBRECHAT_JWT_REFRESH_SECRET=replace-with-64-hex-token
LIBRECHAT_CREDS_KEY=replace-with-64-hex-token

# CREDS_IV is 16 random bytes (32 hexadecimal characters).
LIBRECHAT_CREDS_IV=replace-with-32-hex-token

# An LLM key is required for the default OpenAI endpoint. It is not sent to ClickHouse MCP.
LIBRECHAT_OPENAI_KEY=replace-with-openai-api-key
LIBRECHAT_PORT=3080

# Hosted deployment only (`compose.hosted.yaml`). It reuses CH_HOST/CH_PORT
# from the dashboard env file and attaches LibreChat to the existing Caddy network.
MCP_CLICKHOUSE_USER=agent_ro
MCP_CLICKHOUSE_PASSWORD=replace-with-agent-ro-password
MCP_CLICKHOUSE_DATABASE=sonyliv_final
LIBRECHAT_CONFIG_PATH=/opt/viewers-without-borders/librechat.yaml
CADDY_NETWORK=dashboard_public
LIBRECHAT_HOSTNAME=chat-viewers-without-borders.barundebnath.com

# LibreChat v0.8.7 has no anonymous chat session. For the judging window, seed
# the bootstrap admin first and then set registration true so judges can create
# ordinary USER accounts. Return it to false after the demo.
LIBRECHAT_ALLOW_REGISTRATION=true
LIBRECHAT_SESSION_EXPIRY=1800000
LIBRECHAT_REFRESH_TOKEN_EXPIRY=28800000
LIBRECHAT_BAN_DURATION=7200000
LIBRECHAT_BAN_INTERVAL=10
LIBRECHAT_LOGIN_MAX=7
LIBRECHAT_LOGIN_WINDOW=5
LIBRECHAT_REGISTER_MAX=3
LIBRECHAT_REGISTER_WINDOW=60
LIBRECHAT_CONCURRENT_MESSAGE_MAX=1
LIBRECHAT_MESSAGE_IP_MAX=30
LIBRECHAT_MESSAGE_IP_WINDOW=10
LIBRECHAT_MESSAGE_USER_MAX=12
LIBRECHAT_MESSAGE_USER_WINDOW=10
LIBRECHAT_NON_BROWSER_VIOLATION_SCORE=20
LIBRECHAT_MESSAGE_VIOLATION_SCORE=2
LIBRECHAT_CONCURRENT_VIOLATION_SCORE=2

# Operations-only recovery credentials for the first ADMIN account. These are
# not passed to the application container and must stay only in the ignored env.
LIBRECHAT_BOOTSTRAP_ADMIN_EMAIL=operator@viewers-without-borders.invalid
LIBRECHAT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-64-hex-token
