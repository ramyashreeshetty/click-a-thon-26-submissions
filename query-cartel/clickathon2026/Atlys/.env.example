# ---- LibreChat (mandatory, else crash — ENGINEERING.md §6.1) ----
# Generate with: openssl rand -hex 32  (CREDS_KEY)  /  openssl rand -hex 16  (CREDS_IV)
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
TRUST_PROXY=1
# MONGO_URI is set in docker-compose (bundled mongo service) — D13

# ---- The only LLM: Z.ai GLM (D11) ----
# Used by LibreChat (via librechat.yaml) AND by FastAPI's chat proxy/provision script.
ZAI_API_KEY=

# ---- Langfuse (D2/D14) — optional; the pipeline runs with the NullTracer ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=

# ---- Atlys orchestrator (FastAPI) ----
# ClickHouse Cloud (D3 — the only datastore)
CH_HOST=
CH_USER=default
CH_PASSWORD=
CH_SECURE=true
ATLYS_DB=atlys
# Run with no ClickHouse (in-memory): ATLYS_DRY_RUN=1
ATLYS_DRY_RUN=0
# Automatically approve proposed schemas (dev convenience, NOT for the demo)
ATLYS_AUTO_APPROVE=0
# Max MCP tool calls per user-initiated chat series (auto-continues share the budget).
# User can reply "continue" to start a fresh allowance. Default: 25
ATLYS_MAX_TOOL_CALLS_PER_SERIES=50

# ---- LibreChat agent auto-provisioning (D12) ----
# FastAPI uses these to call LibreChat's REST API on startup and create the
# "Atlys PM" agent automatically. Set to the credentials of the first account
# you register at http://localhost:3080 (or http://localhost:3080 after first boot).
LIBRECHAT_ADMIN_EMAIL=admin@atlys.local
LIBRECHAT_ADMIN_PASSWORD=
# Optional override; normally written by provision_agent.py to generated/.atlys_librechat_api_key
# LIBRECHAT_API_KEY=
# Internal Docker URL (no tunnel needed when both run in docker-compose):
LIBRECHAT_URL=http://librechat:3080
# (Optional) Force a specific agent_id — normally written by provision_agent.py:
# ATLYS_AGENT_ID=
