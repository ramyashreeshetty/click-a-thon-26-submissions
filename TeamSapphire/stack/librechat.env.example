# LibreChat configuration, bind-mounted into the container as /app/.env.
#
# Every secret value below is redacted. This file documents the shape of the
# configuration — which variables exist and what each wires together — not the
# values, which are not published anywhere in this repository.

HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://35.200.218.190:3080
DOMAIN_SERVER=http://35.200.218.190:3080

MONGO_URI=<redacted>
MEILI_HOST=http://librechat-meilisearch:7700
MEILI_MASTER_KEY=<redacted>
MEILI_NO_ANALYTICS=true

CREDS_KEY=<redacted>
CREDS_IV=<redacted>
JWT_SECRET=<redacted>
JWT_REFRESH_SECRET=<redacted>

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false

# TODO: fill in before LibreChat can actually serve either provider
ANTHROPIC_API_KEY=<redacted>
GOOGLE_KEY=<redacted>

RAG_API_URL=http://librechat-rag-api:8000
RAG_PORT=8000

LANGFUSE_PUBLIC_KEY=<redacted>
LANGFUSE_SECRET_KEY=<redacted>
LANGFUSE_BASE_URL=http://langfuse-web:3000
