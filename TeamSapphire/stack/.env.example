# Stack-wide configuration for docker-compose.yml (Langfuse, HyperDX, MCP, LibreChat).
#
# Every secret value below is redacted. This file documents the shape of the
# configuration — which variables exist and what each wires together — not the
# values, which are not published anywhere in this repository.

# ClickStack / HyperDX image config
HDX_IMAGE_REPO=docker.hyperdx.io
CH_IMAGE_REPO=docker.clickhouse.com
IMAGE_NAME_DOCKERHUB=hyperdx/hyperdx
NEXT_OTEL_COLLECTOR_IMAGE_NAME_DOCKERHUB=clickhouse/clickstack-otel-collector
IMAGE_VERSION=2

HYPERDX_API_PORT=8000
HYPERDX_APP_PORT=8080
HYPERDX_OPAMP_PORT=4320
HYPERDX_APP_URL=http://35.200.218.190
HYPERDX_LOG_LEVEL=info
HYPERDX_API_KEY=<redacted>
HYPERDX_OTEL_EXPORTER_CLICKHOUSE_DATABASE=otel
USAGE_STATS_ENABLED=false

VM_EXTERNAL_IP=35.200.218.190

# ClickHouse Cloud
CLICKHOUSE_CLOUD_HTTPS_ENDPOINT=https://x6fcqwjunt.ap-south-1.aws.clickhouse.cloud:8443
CLICKHOUSE_CLOUD_HOST=x6fcqwjunt.ap-south-1.aws.clickhouse.cloud

OTEL_WRITER_USER=otel_writer
OTEL_WRITER_PASSWORD=<redacted>
DASHBOARD_RO_USER=dashboard_ro
DASHBOARD_RO_PASSWORD=<redacted>
LANGFUSE_WRITER_USER=langfuse_writer
LANGFUSE_WRITER_PASSWORD=<redacted>
MCP_AGENT_USER=mcp_agent
MCP_AGENT_PASSWORD=<redacted>

# LibreChat
MEILI_MASTER_KEY=<redacted>
LIBRECHAT_UID=1001
LIBRECHAT_GID=1002
LIBRECHAT_PORT=3080
LIBRECHAT_PG_PASSWORD=<redacted>

# Langfuse
LANGFUSE_NEXTAUTH_SECRET=<redacted>
LANGFUSE_SALT=<redacted>
LANGFUSE_ENCRYPTION_KEY=<redacted>
LANGFUSE_POSTGRES_PASSWORD=<redacted>
LANGFUSE_REDIS_AUTH=<redacted>
LANGFUSE_MINIO_ROOT_USER=langfuse-admin
LANGFUSE_MINIO_ROOT_PASSWORD=<redacted>
CLICKHOUSE_CLOUD_NATIVE_ENDPOINT=tcp://x6fcqwjunt.ap-south-1.aws.clickhouse.cloud:9440?secure=true
LANGFUSE_INIT_ORG_ID=clickathon-org
LANGFUSE_INIT_ORG_NAME=Clickathon
LANGFUSE_INIT_PROJECT_ID=clickathon-project
