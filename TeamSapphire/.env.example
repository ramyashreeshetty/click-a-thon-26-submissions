# Copy to .env and fill in. .env is gitignored — never commit real values.

# ClickHouse Cloud
CLICKHOUSE_HOST=xxxxxxxxxx.ap-south-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=inmobi
# Read-only user for the API and MCP. Admin/default only for DDL and loading.
CLICKHOUSE_USER=dashboard_ro
CLICKHOUSE_PASSWORD=

# LLM — narration only, never sees raw events
ANTHROPIC_API_KEY=

# Langfuse — the investigation trace lands here. This is a judged artifact.
LANGFUSE_HOST=http://100.77.198.37:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ClickStack / HyperDX — OTel traces of our own pipeline
OTEL_EXPORTER_OTLP_ENDPOINT=http://100.77.198.37:4318
OTEL_EXPORTER_OTLP_HEADERS=authorization=

# API
API_PORT=8010
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
