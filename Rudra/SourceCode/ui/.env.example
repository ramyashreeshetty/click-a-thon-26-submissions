# Copy to ui/.env (gitignored). Use a READ-ONLY ClickHouse user for the UI.
CH_URL=https://your-service.region.aws.clickhouse.cloud:8443/
CH_USER=default
CH_PASSWORD=changeme
PORT=8787
# Tags every dashboard query in system.query_log.log_comment (filterable in HyperDX).
LOG_COMMENT=sonyliv-dashboard
