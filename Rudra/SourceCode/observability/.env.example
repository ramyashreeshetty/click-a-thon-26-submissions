# Copy to observability/.env (gitignored).

# ── ClickStack OTel collector (docker-compose.yml) ─────────────────────────
# Where the collector writes telemetry (the otel_* tables live here).
CLICKHOUSE_ENDPOINT=https://your-service.region.aws.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme

# ── ingester/ (instrumented client; reads standard env vars) ───────────────
CLICKHOUSE_HOST=your-service.region.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=sonyliv

TELEMETRY_ENABLED=true
OTEL_SERVICE_NAME=frontrow-pipeline
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
