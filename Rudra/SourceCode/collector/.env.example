# Copy to collector/.env and fill in (collector/.env is gitignored).

# ClickHouse HTTP(S) endpoint — base URL, no trailing path.
# Cloud:  https://your-service.region.aws.clickhouse.cloud:8443
# Local:  http://host.docker.internal:8123
CH_ENDPOINT=https://your-service.region.aws.clickhouse.cloud:8443
CH_DATABASE=sonyliv
CH_USER=default
CH_PASSWORD=changeme

# Collector scale knobs (raise for 100x/1000x; no code changes)
HTTP_PORT=8080
BATCH_MAX_EVENTS=50000
BATCH_TIMEOUT_SECS=5
BUFFER_MAX_SIZE=536870912

# Simulator: CSV to replay as a live stream (defaults for simulator.py)
RAW_CSV=/path/to/ch-hackathon-raw-data.csv
#COLLECTOR_URL=http://localhost:8080/ingest
