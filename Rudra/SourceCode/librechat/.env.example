# Copy to librechat/.env and fill in.  Secrets generator: https://www.librechat.ai/toolkit/creds_generator

# ── LibreChat core ──
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=masterKey
CONFIG_PATH=/app/librechat.yaml
CREDS_KEY=replace_with_32_byte_hex
CREDS_IV=replace_with_16_byte_hex
JWT_SECRET=replace_with_random
JWT_REFRESH_SECRET=replace_with_random

# ── LLM provider (pick one; needed to power the chat) ──
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── ClickHouse MCP server -> our concurrency service (read-only) ──
CLICKHOUSE_HOST=your-service.region.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme

# Auth: no default creds — register the first user at http://localhost:3080/register
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false

# ClickHouse (for the mcp-clickhouse SSE sidecar)
CH_HOST=your-service.region.aws.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=changeme
CH_SECURE=true
