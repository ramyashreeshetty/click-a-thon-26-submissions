# Docker Compose extras (not used by the Go binary directly)
NGROK_AUTHTOKEN=
HYPERDX_OTLP_ENDPOINT=https://in-otel.hyperdx.io   # your HyperDX / ClickStack OTLP endpoint
HYPERDX_API_KEY=                                     # your HyperDX ingestion API key

# ClickHouse Cloud connection
CLICKHOUSE_HOST=<your-service>.clickhouse.cloud
CLICKHOUSE_PORT=9440
CLICKHOUSE_DB=inmobi-analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true  # set false for local non-TLS (port 9000)

# OpenTelemetry / ClickStack
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable OTel (plain JSON logs locally)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=clickhouse-go-service
# For Managed ClickStack add the auth header:
# OTEL_EXPORTER_OTLP_HEADERS=authorization=<YOUR_INGESTION_API_KEY>


SERVER_PORT=8080
GIN_MODE=release

# Ingestion
BATCH_MAX_SIZE=10000

# Dual-resolution anomaly detection
DETECTION_CHECK_FREQUENCY=1m
DETECTION_LATENESS_ALLOWANCE=1m
DETECTION_FAST_WINDOW=5m
DETECTION_STANDARD_WINDOW=10m
DETECTION_PERSISTENCE_CHECKS=2
DETECTION_LOOKBACK_WEEKS=5
DETECTION_MIN_BASELINE_N=3
DETECTION_MAX_EPISODES_PER_RUN=10
# V1 Detect scans complete calendar days. Use 1h only for an hourly v1 client.
DETECTION_WINDOW=1d
# Short-window counters are naturally noisier than ratios. Require a 10%
# request/revenue movement before v2 treats a high z-score as commercial.
DETECTION_V2_ADDITIVE_MIN_DEVIATION_PCT=0.10
# Rejoin sparse seasonal slots from one sustained historical incident.
DETECTION_V2_HISTORICAL_MERGE_GAP=24h
# Enable this once for an existing raw-data deployment. Backfill only runs when
# each v2 aggregate is empty, so retries do not duplicate SummingMergeTree rows.
DETECTION_AUTO_BACKFILL=false
# Run the 5m/10m real-time pipeline automatically every check interval.
DETECTION_SCHEDULER_ENABLED=false

# Deterministic guardrails for every investigation-agent SQL query.
AGENT_QUERY_TIMEOUT=3s
AGENT_MAX_ROWS_TO_READ=10000000
AGENT_MAX_BYTES_TO_READ=1000000000
AGENT_MAX_RESULT_ROWS=1000

# OpenAI investigation agent and evidence-grounded narrator.
# NARRATOR_ENABLED is kept as the single backwards-compatible toggle and
# enables both stages unless INVESTIGATION_ENABLED is explicitly set.
LLM_ENABLED=false
# Optional per-stage overrides:
# INVESTIGATION_ENABLED=true
# NARRATOR_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
INVESTIGATION_MODEL=gpt-5.6-sol
NARRATOR_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT=30s
OPENAI_MAX_OUTPUT_TOKENS=4000
INVESTIGATION_MAX_STEPS=12
INVESTIGATION_MAX_QUERIES=8
