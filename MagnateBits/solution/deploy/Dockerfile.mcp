FROM python:3.12-slim

WORKDIR /app/Atlys/solution

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY . .

RUN pip install --no-cache-dir -e ".[mcp]" \
    && pip install --no-cache-dir 'mcp[cli]>=1.6.0' uvicorn starlette

ENV PYTHONUNBUFFERED=1
ENV ATLYS_MCP_HOST=0.0.0.0
ENV ATLYS_MCP_PORT=8100

EXPOSE 8100
CMD ["python", "-m", "atlys_mcp"]
