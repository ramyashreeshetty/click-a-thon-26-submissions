# ---- ClickHouse (local Docker for dev; swap host/user/password for Cloud) ----
CH_HOST=localhost
CH_PORT=8123
CH_USER=atlys
CH_PASSWORD=atlys
CH_DATABASE=atlys
CH_SECURE=false

# ---- Langfuse (cloud free tier) ----
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- LLM ----
# Runs on the Claude subscription via the authenticated `claude` CLI.
# No API key needed. Requires Claude Code installed and logged in.
ATLYS_LLM_BACKEND=cli
ATLYS_LLM_MODEL=claude-sonnet-5
ATLYS_LLM_TIMEOUT_S=600
# "low" is correct for this pipeline: every call hands the model fully-computed context
# (profile, house rules, query frames) for bounded JSON emission, not open-ended
# exploration. Measured: unset (CLI default) cost 5x the wall-clock and 3.6x the output
# tokens of "low" on the identical real workload, with no difference in output quality.
ATLYS_LLM_EFFORT=low

# Optional fallback: set ATLYS_LLM_BACKEND=api and supply a key instead.
# ANTHROPIC_API_KEY=sk-ant-...
#
# ---- Alternative LLM backends (for the model bake-off) ----
# ATLYS_LLM_BACKEND=openai routes every pipeline LLM call to any OpenAI-compatible
# /v1/chat/completions host. Defaults to Ollama Cloud; override with ATLYS_LLM_BASE_URL.
# Key comes from ATLYS_LLM_API_KEY, falling back to OLLAMA_API_KEY.
#   ATLYS_LLM_BACKEND=openai ATLYS_LLM_MODEL=gpt-oss:120b python -m tools.model_bakeoff
# MEASURED on the current key: gpt-oss:20b and gpt-oss:120b work and emit schema-valid
# JSON; glm-5.2 / deepseek-v4-flash / kimi-k2.6 return 403 (plan tier, not a bad key).
# ATLYS_LLM_BASE_URL=https://ollama.com/v1
# ATLYS_LLM_API_KEY=
#
# Optional offline backend: ATLYS_LLM_BACKEND=mock runs the ENTIRE pipeline (including the
# analytics interpret step) with zero credentials and zero network, deterministically —
# for reproducible eval / offline dev. Output is schema-valid but prose is placeholder;
# all downstream deterministic gates (lint, dry-run, grounding, metric policy) still apply.

# ---- Context retrieval ----
# DEFAULT "vector": in-ClickHouse relevance-ranked retrieval (cosineDistance + HNSW
# vector_similarity index + text index). The layer is now ~400 entries and grows with every
# instrumented feature, past what belongs in every prompt. Retrieval is deterministic (local
# hashing embedding, no network), governance entries (contradictions/gaps/metrics/known
# issues) are ALWAYS included, and it falls back to the full dump if the index isn't built.
# Set to "full" to opt out and dump the whole layer into each prompt instead.
# ATLYS_CONTEXT_RETRIEVAL=vector   # DEFAULT. Set to "full" to dump the whole layer instead.
# ATLYS_RAG_TOP_K=12

# ---- LibreChat (make chat) ----
# Generated by `make chat-secrets`. Do not commit real values.
# CREDS_KEY=
# CREDS_IV=
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# LibreChat's CHAT model only (Ollama Cloud endpoint in deploy/librechat.yaml) --
# separate from ATLYS_LLM_BACKEND=cli. Never put this in ANTHROPIC_API_KEY or
# `claude -p` will refuse subscription auth; tool calls always use the subscription
# regardless of which chat model is selected in the UI.
# Get a key from https://ollama.com/settings/keys. NOTE: GET /v1/models on
# ollama.com is public and returns 200 with NO key at all -- it does not prove a
# key works. Verify with a real completion instead:
#   curl https://ollama.com/v1/chat/completions -H "Authorization: Bearer $OLLAMA_API_KEY" \
#     -H "Content-Type: application/json" -d '{"model":"gpt-oss:20b","messages":[{"role":"user","content":"pong"}]}'
# If that 401s, the key is invalid/expired -- generate a fresh one. The "Ollama
# (local)" endpoint needs no key and works with just `ollama serve` on the host.
# OLLAMA_API_KEY=
