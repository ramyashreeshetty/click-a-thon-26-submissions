# Copy to .env and fill in. Never commit .env — it is gitignored.

# ---- ClickHouse Cloud ------------------------------------------------------
CH_HOST=your-service.ap-south-1.aws.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=REDACTED

# Where the orchestrator writes its analysis
ORCH_DB=rca_orch

# Source tables
EVENTS_TABLE=rca.ad_events
GEO_DEVICE_TABLE=rca.geo_device
APPS_TABLE=rca.apps
ADVERTISERS_TABLE=rca.advertisers
AUDIT_TABLE=rca.ledger

# ---- LLM (OpenAI-compatible; we used OpenRouter) ---------------------------
OPENROUTER_API_KEY=REDACTED
LLM_MODEL=openai/gpt-oss-20b:free

# ---- Langfuse -------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=REDACTED
LANGFUSE_SECRET_KEY=REDACTED
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Caching (seconds; optional) ------------------------------------------
EVENTS_CACHE_TTL=30
VIEW_CACHE_TTL=25
