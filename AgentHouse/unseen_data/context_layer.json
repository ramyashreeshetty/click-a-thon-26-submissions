        "caveats": "Prefer max(timestamp)-relative windows; payload metrics use JSONExtract on payload.",
        "formula": "users reaching purchase_completed / users at destination_card_clicked (windowFunnel on atlys.activity_events using event_name + toDateTime(timestamp))",
