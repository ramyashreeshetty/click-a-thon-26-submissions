# FeatureLens Go service
FEATURELENS_ADDR=:8080
CLICKHOUSE_HOST=your-service.region.clickhouse.cloud
CLICKHOUSE_HTTP_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_SOURCE_DATABASE=atlys
CLICKHOUSE_CONTROL_DATABASE=featurelens_poc

# Langfuse Cloud (EU default; change the base URL for another region)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keep development and production traces separate and attach each deployment
# to a release so quality, latency, and cost regressions can be compared.
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=local

# Governed Analytics Agent synthesis (any OpenAI-compatible chat endpoint)
# Leave API key or model blank to retain the deterministic insight fallback.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30s
LLM_PROMPT_VERSION=analytics-insight:v5

# OpenRouter example:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4.1-mini

# React control plane
NEXT_PUBLIC_FEATURELENS_API=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LIBRECHAT_URL=http://localhost:3080

# LibreChat -> FeatureLens MCP
FEATURELENS_MCP_URL=http://host.docker.internal:8080/mcp

# Optional sequential replay of the supplied Atlys fixtures
ATLYS_DATASET_DIR=/absolute/path/to/click-a-thon-2026/Atlys
FEATURELENS_API_URL=http://localhost:8080
FEATURELENS_USE_EXISTING_DATA=true
